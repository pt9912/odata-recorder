!tools/harness/lint.sh
!.a-check.yml
!tools/gegenproben
!tools/pruefung
!tools/groessenmarke
!tools/harness/groessenmarke.sh
!tools/harness/migration-check.sh
!docs/user
!Makefile
!d-check.mk
!repo.mk
!Dockerfile
!harness/mk
